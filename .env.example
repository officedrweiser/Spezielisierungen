# E-Mail-Adresse, an die Kontaktanfragen gesendet werden
CONTACT_RECIPIENT=office@drweiser.at

# Absenderadresse (muss beim SMTP-Anbieter meist verifiziert sein)
SMTP_FROM=website@drweiser.at

# SMTP-Zugangsdaten des Hosting-/E-Mail-Anbieters.
# Fehlen diese Werte, wird keine echte E-Mail verschickt, sondern der Inhalt
# nur in der Server-Konsole protokolliert (nützlich zum lokalen Testen).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

PORT=3000
