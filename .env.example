# Konfiguration für den Node.js-Server (server/server.js).
# Für klassisches PHP-Webhosting wird stattdessen public/api/config.php
# verwendet – siehe ANLEITUNG-KONTAKTFORMULAR.md.

# E-Mail-Adresse, an die Kontaktanfragen gesendet werden
CONTACT_RECIPIENT=office@drweiser.at

# Absenderadresse. Wichtig: drweiser.at ist mit DMARC "p=reject" geschützt.
# Hier muss eine Adresse stehen, für die das SMTP-Postfach unten senden darf –
# im Normalfall genau die Adresse von SMTP_USER.
SMTP_FROM=office@drweiser.at

# SMTP-Zugangsdaten des E-Mail-Anbieters.
# Fehlen diese Werte, wird keine echte E-Mail verschickt, sondern der Inhalt
# nur in der Server-Konsole protokolliert (nützlich zum lokalen Testen).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=office@drweiser.at
SMTP_PASS=

PORT=3000
