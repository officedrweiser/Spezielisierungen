# Konfiguration für klassisches Apache-Webhosting (A1, World4You, Plesk, cPanel …).
# Auf einem Node.js-Hoster wird diese Datei ignoriert – dort übernimmt
# server/server.js dieselben Aufgaben.

# Keine Ordnerinhalte auflisten, wenn eine Adresse auf einen Ordner zeigt.
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Schutz vor Lücken im PHP-Programm des Servers (z. B. „PHP2Shell“,
  # CVE-2026-109618 / CVE-2026-109619, Oktober 2026). Solche Lücken greifen
  # schon beim Einlesen einer Anfrage, bevor das Formular-Skript läuft.
  # Deshalb erreicht nur das PHP, was das Formular wirklich schickt: POST,
  # Inhalt JSON, höchstens 20 000 Byte. Datei-Uploads (multipart) und alles
  # andere weist der Webserver selbst ab. Ersetzt NICHT das PHP-Update beim
  # Hoster, verkleinert aber die Angriffsfläche.
  #
  # Außer dem Formular-Skript führt diese Website kein PHP aus. Jede andere
  # .php-Adresse (auch Reste der alten WordPress-Seite) gibt es daher nicht.
  RewriteRule ^(?!api/contact\.php$).+\.php(/.*)?$ - [R=404,L,NC]
  RewriteCond %{REQUEST_METHOD} !=POST
  RewriteRule ^api/contact(\.php)?(/.*)?$ - [R=405,L]
  RewriteCond %{HTTP:Content-Type} !^application/json [NC]
  RewriteRule ^api/contact(\.php)?(/.*)?$ - [R=415,L]
  RewriteCond %{HTTP:Content-Length} ^[0-9]{6,}$ [OR]
  RewriteCond %{HTTP:Content-Length} ^(2000[1-9]|200[1-9][0-9]|20[1-9][0-9]{2}|2[1-9][0-9]{3}|[3-9][0-9]{4})$
  RewriteRule ^api/contact(\.php)?(/.*)?$ - [R=413,L]

  # Das Formular sendet an /api/contact – hier auf das PHP-Skript umleiten.
  RewriteRule ^api/contact/?$ /api/contact.php [L]

  # Adressen der alten WordPress-Seite (bis 10/2026) dauerhaft auf die neuen
  # Seiten umleiten, damit Suchergebnisse, Lesezeichen und Anzeigen weiter
  # funktionieren. Angehängte Parameter (z. B. gclid von Google Ads) bleiben
  # erhalten. /sprechstelle-3400/ entfällt bewusst (Auftraggeber, 10/2026).
  # Keine HTTPS-Weiterleitung hier – die macht der A1-Kundenbereich.
  RewriteRule ^kontakt/?$ /kontakt.html [R=301,L,NC]
  RewriteRule ^schwerpunkte/?$ /leistungen.html [R=301,L,NC]
  RewriteRule ^ueber_uns/?$ /ueber-uns.html [R=301,L,NC]
  RewriteRule ^impressum/?$ /impressum.html [R=301,L,NC]
  RewriteRule ^privacy-policy/?$ /datenschutz.html [R=301,L,NC]
</IfModule>

# Zugangsdaten, Vorlagen und versehentliche Kopien davon niemals ausliefern
# (z. B. config.php, config.example.php, config.php.txt, config.php.bak,
# config.php~). Ebenso versteckte Dateien wie .htaccess oder .env.
<FilesMatch "(^config.*|~$|\.(bak|old|orig|save|swp|tmp|log|md)$|^\.)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

ErrorDocument 404 /404.html

# Sicherheits-Header (dieselben Werte wie im Node-Server).
# Google Ads (erst nach Cookie-Zustimmung, Hosts laut Google-CSP-Leitfaden)
# und die Google-Karte auf der Kontaktseite sind ausdrücklich erlaubt, alles andere
# nur vom eigenen Server.
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://www.googletagmanager.com https://www.googleadservices.com https://www.google.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://www.googletagmanager.com https://www.googleadservices.com https://googleads.g.doubleclick.net https://pagead2.googlesyndication.com https://www.google.com https://www.google.at; font-src 'self'; connect-src 'self' https://www.googletagmanager.com https://www.googleadservices.com https://googleads.g.doubleclick.net https://pagead2.googlesyndication.com https://www.google.com https://www.google.at https://ad.doubleclick.net; frame-src https://www.google.com https://maps.google.com https://www.googletagmanager.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  # Browser merken sich für ein Jahr, die Seite nur verschlüsselt aufzurufen
  # (wird nur bei HTTPS-Aufrufen gesendet).
  Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
</IfModule>
